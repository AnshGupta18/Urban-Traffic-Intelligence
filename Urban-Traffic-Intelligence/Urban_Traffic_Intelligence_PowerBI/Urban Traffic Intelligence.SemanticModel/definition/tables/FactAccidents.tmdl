	partition FactAccidents = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Aditya2213/INDIAN_ROAD_ACCIDENT_DATASET_DASHBOARD/main/indian_roads_dataset.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    CleanText = Table.TransformColumns(PromotedHeaders, {
				        {"city", each Text.Trim(_), type text}, {"state", each Text.Trim(_), type text},
				        {"day_of_week", each Text.Trim(_), type text}, {"road_type", each Text.Trim(_), type text},
				        {"weather", each Text.Trim(_), type text}, {"visibility", each Text.Trim(_), type text},
				        {"traffic_density", each Text.Trim(_), type text}, {"cause", each Text.Trim(_), type text},
				        {"accident_severity", each Text.Trim(_), type text},
				        {"festival", each if _ = null then null else Text.Trim(_), type text}
				    }),
				    ParseDate = (x as any) as nullable date =>
				        let
				            s = Text.Trim(Text.From(x)),
				            p = Text.Split(s, "-")
				        in
				            if List.Count(p) = 3 then
				                try #date(Number.FromText(p{2}), Number.FromText(p{1}), Number.FromText(p{0})) otherwise null
				            else null,
				    Typed = Table.TransformColumnTypes(CleanText, {
				        {"accident_id", Int64.Type}, {"city", type text}, {"state", type text},
				        {"latitude", type number}, {"longitude", type number},
				        {"hour", Int64.Type}, {"day_of_week", type text},
				        {"is_weekend", Int64.Type}, {"road_type", type text}, {"lanes", Int64.Type},
				        {"traffic_signal", Int64.Type}, {"weather", type text}, {"visibility", type text},
				        {"temperature", type number}, {"traffic_density", type text}, {"cause", type text},
				        {"accident_severity", type text}, {"vehicles_involved", Int64.Type},
				        {"casualties", Int64.Type}, {"is_peak_hour", Int64.Type}, {"festival", type text},
				        {"risk_score", type number}, {"time", type text}
				    }),
				    ParsedDate = Table.TransformColumns(Typed, {{"date", ParseDate, type date}}),
				    CleanNullFestival = Table.ReplaceValue(ParsedDate, "", null, Replacer.ReplaceValue, {"festival"}),
				    AddLocationKey = Table.AddColumn(CleanNullFestival, "LocationKey", each [state] & "|" & [city], type text),
				    AddDateKey = Table.AddColumn(AddLocationKey, "DateKey", each Date.ToText([date], "yyyyMMdd"), type text),
				    AddRoadKey = Table.AddColumn(AddDateKey, "RoadTypeKey", each [road_type], type text),
				    AddWeatherKey = Table.AddColumn(AddRoadKey, "WeatherKey", each [weather], type text),
				    AddCauseKey = Table.AddColumn(AddWeatherKey, "CauseKey", each [cause], type text),
				    AddSeverityKey = Table.AddColumn(AddCauseKey, "SeverityKey", each [accident_severity], type text),
				    AddYear = Table.AddColumn(AddSeverityKey, "Year", each Date.Year([date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddYear, "Month", each Date.Month([date]), Int64.Type),
				    AddMonthName = Table.AddColumn(AddMonth, "Month Name", each Date.MonthName([date]), type text),
				    AddHourLabel = Table.AddColumn(AddMonthName, "Hour Label", each Text.PadStart(Text.From([hour]), 2, "0") & ":00", type text),
				    RemoveDuplicates = Table.Distinct(AddHourLabel, {"accident_id"})
				in
				    RemoveDuplicates

	annotation PBI_ResultType = Table

