table FactAccidents
	lineageTag: 8d5c8f3b-1b32-4c9e-9d5e-factaccidents

	measure 'Accident Records' = COUNTROWS('FactAccidents')
		formatString: #,##0
		lineageTag: 043bb1d6-9c34-406a-be0a-18aeb7e3fde4

	measure 'Fatal Records' = CALCULATE(COUNTROWS('FactAccidents'), 'FactAccidents'[SeverityKey] = "fatal")
		formatString: #,##0
		lineageTag: 3e9ddefd-b91e-4b10-8854-4aa403d51a70

	measure 'Total Casualties' = SUM('FactAccidents'[casualties])
		formatString: #,##0
		lineageTag: b7982595-d07e-45e5-a327-2ee3600e1d1c

	measure 'Average Risk Score' = AVERAGE('FactAccidents'[risk_score])
		formatString: 0.00
		lineageTag: 5493103a-d674-4f5f-9b15-d2f5d53b2348

	measure 'Average Casualties per Accident' = DIVIDE([Total Casualties], [Accident Records])
		formatString: 0.00
		lineageTag: 7eb0eb59-d251-453a-b988-ca7f6595f7be

	measure 'Peak Hour Records' = CALCULATE([Accident Records], 'FactAccidents'[is_peak_hour] = 1)
		formatString: #,##0
		lineageTag: 226dac7f-1985-4b34-93cd-25ea9488b2d6

	measure 'Weekend Records' = CALCULATE([Accident Records], 'FactAccidents'[is_weekend] = 1)
		formatString: #,##0
		lineageTag: 3179c132-79ac-402f-924e-c0ae483bbc31

